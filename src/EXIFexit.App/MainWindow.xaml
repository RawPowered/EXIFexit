<Window x:Class="EXIFexit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EXIFexit 2.0"
        Height="820" Width="1280"
        MinHeight="700" MinWidth="1000"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource TitleText}" Text="EXIFexit"/>
                <TextBlock Style="{StaticResource MutedText}"
                           Text="Shred · edit · scramble EXIF &amp; PDF metadata. Wear any device mask — offline, originals safe by default."/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Language" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource MutedText}"/>
                <ComboBox Width="160" ItemsSource="{Binding LanguageOptions}"
                          SelectedItem="{Binding SelectedLanguageDisplay}"/>
            </StackPanel>
        </Grid>

        <!-- Body: queue + workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Queue panel -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="10" Padding="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Job Queue" Margin="0,0,0,8"/>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Add Files…" Command="{Binding AddFilesCommand}"/>
                        <Button Content="Folder…" Command="{Binding AddFolderCommand}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Remove" Command="{Binding RemoveSelectedCommand}"/>
                        <Button Content="Clear" Style="{StaticResource DangerButton}" Command="{Binding ClearQueueCommand}"/>
                    </StackPanel>
                    <CheckBox DockPanel.Dock="Top" Content="Recursive folders" IsChecked="{Binding RecursiveFolders}"/>
                    <ListBox ItemsSource="{Binding Queue}"
                             SelectedItem="{Binding SelectedQueueItem}"
                             Margin="0,8,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Inherit list-item foreground so selection stays readable -->
                                        <TextBlock Text="{Binding KindLabel}" FontWeight="Bold" Width="40" Opacity="0.95"/>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding MetaSummary}" Opacity="0.85" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding StatusText}" Opacity="0.75" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Workspace tabs -->
            <TabControl Grid.Column="2">
                <!-- SHRED -->
                <TabItem Header="Shred">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <StackPanel>
                            <GroupBox Header="Output">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Folder" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                    <TextBox Grid.Column="1" Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6"/>
                                    <TextBlock Grid.Row="1" Text="Suffix" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" Width="160" HorizontalAlignment="Left" Margin="0,0,0,6"/>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal">
                                        <CheckBox Content="Keep ICC profile" IsChecked="{Binding KeepIcc}"/>
                                        <CheckBox Content="Overwrite existing outputs" IsChecked="{Binding Overwrite}"/>
                                        <CheckBox Content="Overwrite source in-place" IsChecked="{Binding OverwriteInPlace}" Foreground="{StaticResource DangerBrush}"/>
                                        <CheckBox Content="Verify after write" IsChecked="{Binding VerifyAfter}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Shred Queue" Style="{StaticResource AccentButton}" Command="{Binding ShredQueueCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBoolConverter}}"/>
                                        <Button Content="Open Output Folder" Command="{Binding OpenOutputFolderCommand}"/>
                                        <Button Content="Cancel" Command="{Binding CancelJobCommand}"/>
                                        <Button Content="Verify Selected" Command="{Binding VerifySelectedCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <GroupBox Header="Metadata diff / residual">
                                <TextBox Text="{Binding DiffReport}" IsReadOnly="True" TextWrapping="Wrap"
                                         MinHeight="120" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            </GroupBox>
                            <GroupBox Header="Verify report">
                                <TextBox Text="{Binding VerifyReport}" IsReadOnly="True" TextWrapping="Wrap"
                                         MinHeight="80" AcceptsReturn="True"/>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- EXIF STUDIO -->
                <TabItem Header="EXIF Studio">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Open Image…" Command="{Binding OpenStudioImageCommand}"/>
                            <TextBlock Text="{Binding StudioPath}" VerticalAlignment="Center" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" MaxWidth="600"/>
                        </StackPanel>
                        <GroupBox Grid.Row="1" Header="Quick fields">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,8,6">
                                    <TextBlock Text="Make" Style="{StaticResource MutedText}"/>
                                    <TextBox Text="{Binding QuickMake, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,6">
                                    <TextBlock Text="Model" Style="{StaticResource MutedText}"/>
                                    <TextBox Text="{Binding QuickModel, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,0,6">
                                    <TextBlock Text="Software" Style="{StaticResource MutedText}"/>
                                    <TextBox Text="{Binding QuickSoftware, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Margin="0,0,8,6">
                                    <TextBlock Text="Artist" Style="{StaticResource MutedText}"/>
                                    <TextBox Text="{Binding QuickArtist, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,8,6">
                                    <TextBlock Text="DateTime" Style="{StaticResource MutedText}"/>
                                    <TextBox Text="{Binding QuickDateTime, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                                    <TextBlock Text="GPS Lat / Lon" Style="{StaticResource MutedText}"/>
                                    <DockPanel>
                                        <TextBox Text="{Binding QuickGpsLat, UpdateSourceTrigger=PropertyChanged}" Width="100" Margin="0,0,6,0"/>
                                        <TextBox Text="{Binding QuickGpsLon, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DockPanel>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Apply Quick → Table" Command="{Binding ApplyQuickToTableCommand}"/>
                                    <TextBox Text="{Binding StudioOutputDirectory, UpdateSourceTrigger=PropertyChanged}" Width="280" Margin="8,0"/>
                                    <TextBox Text="{Binding StudioSuffix, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                    <Button Content="Write EXIF &amp; Save" Style="{StaticResource AccentButton}" Command="{Binding WriteExifCommand}"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <DataGrid Grid.Row="2" ItemsSource="{Binding ExifRows}" Margin="0,8,0,8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Directory" Binding="{Binding Directory}" Width="140"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                                <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="3" Text="{Binding StudioStatus}" Style="{StaticResource MutedText}"/>
                    </Grid>
                </TabItem>

                <!-- PDF STUDIO -->
                <TabItem Header="PDF Studio">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Open PDF…" Command="{Binding OpenPdfCommand}"/>
                            <TextBlock Text="{Binding PdfPath}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1.4*"/>
                            </Grid.ColumnDefinitions>
                            <GroupBox Header="File data" Grid.Column="0">
                                <DataGrid ItemsSource="{Binding PdfFileInfo}" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Field" Binding="{Binding Key}" Width="120"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <GroupBox Header="Document metadata" Grid.Column="2">
                                <DataGrid ItemsSource="{Binding PdfRows}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="140"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox Text="{Binding PdfOutputDirectory, UpdateSourceTrigger=PropertyChanged}" Width="280"/>
                            <TextBox Text="{Binding PdfSuffix, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                            <CheckBox Content="Strip XMP when shredding" IsChecked="{Binding PdfStripXmp}" VerticalAlignment="Center"/>
                            <Button Content="Write Metadata" Style="{StaticResource AccentButton}" Command="{Binding WritePdfCommand}"/>
                            <Button Content="Shred PDF Metadata" Style="{StaticResource DangerButton}" Command="{Binding ShredPdfCommand}"/>
                            <TextBlock Text="{Binding PdfStatus}" VerticalAlignment="Center" Style="{StaticResource MutedText}" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- SCRAMBLE -->
                <TabItem Header="Scramble / Mask">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                        <StackPanel>
                            <GroupBox Header="Device mask">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,12,8"/>
                                    <TextBlock Grid.Column="2" Text="Region" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <ComboBox Grid.Column="3" ItemsSource="{Binding RegionOptions}" SelectedItem="{Binding SelectedRegion}" Margin="0,0,0,8"/>
                                    <TextBlock Grid.Row="1" Text="Mask" VerticalAlignment="Center" Margin="0,0,8,8"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding MaskLabels}" SelectedItem="{Binding SelectedMaskLabel}" Margin="0,0,8,8"/>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding MaskCountText}" VerticalAlignment="Center" Style="{StaticResource MutedText}"/>
                                    <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal">
                                        <CheckBox Content="GPS jitter" IsChecked="{Binding ScrambleGps}"/>
                                        <CheckBox Content="Random dates" IsChecked="{Binding ScrambleDates}"/>
                                        <CheckBox Content="Fake exposure" IsChecked="{Binding ScrambleExposure}"/>
                                        <TextBlock Text="Artist" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox Text="{Binding ScrambleArtist, UpdateSourceTrigger=PropertyChanged}" Width="140"/>
                                        <TextBlock Text="Comment" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox Text="{Binding ScrambleComment, UpdateSourceTrigger=PropertyChanged}" Width="180"/>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="Random mask" Command="{Binding RandomMaskCommand}"/>
                                <Button Content="Preview scramble" Command="{Binding PreviewScrambleCommand}"/>
                                <Button Content="Apply → EXIF Studio" Command="{Binding ApplyScrambleToExifStudioCommand}"/>
                                <Button Content="Apply → PDF Studio" Command="{Binding ApplyScrambleToPdfStudioCommand}"/>
                                <TextBox Text="{Binding ScrambleBatchSuffix, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                                <Button Content="Scramble Queue" Style="{StaticResource AccentButton}" Command="{Binding ScrambleQueueCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ScrambleStatus}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                            <GroupBox Header="Scramble preview (no tool fingerprints)">
                                <TextBox Text="{Binding ScramblePreview}" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" MinHeight="220" FontFamily="Consolas" FontSize="12"
                                         VerticalScrollBarVisibility="Auto"/>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Progress + status -->
        <DockPanel Grid.Row="2" Margin="0,12,0,8">
            <ProgressBar DockPanel.Dock="Top" Value="{Binding Progress}" Maximum="100" Margin="0,0,0,6"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource MutedText}"/>
        </DockPanel>

        <!-- Activity log -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Activity log" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                <ListBox ItemsSource="{Binding LogLines}" BorderThickness="0"
                         Background="{StaticResource Surface2Brush}"
                         Foreground="{StaticResource FgBrush}"
                         FontFamily="Consolas" FontSize="12"
                         Padding="4"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
